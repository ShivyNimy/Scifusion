[{"i":0,"chapter":"Sexual Reproduction in Flowering Plants","topic":"Flower Structure and Pollination","url":"chapter-01-sexual-reproduction-in-flowering-plants/flower-structure-and-pollination/index.html","type":"mcq","q":"Pollen grains are produced in the:","solution":"The anther contains pollen sacs.","options":["Anther","Ovary","Stigma","Filament"],"answer":0},{"i":1,"chapter":"Sexual Reproduction in Flowering Plants","topic":"Flower Structure and Pollination","url":"chapter-01-sexual-reproduction-in-flowering-plants/flower-structure-and-pollination/index.html","type":"mcq","q":"Which agent pollinates colourful, scented flowers?","solution":"Colour and scent attract insects.","options":["Insects","Wind","Water only","Gravity"],"answer":0},{"i":2,"chapter":"Sexual Reproduction in Flowering Plants","topic":"Flower Structure and Pollination","url":"chapter-01-sexual-reproduction-in-flowering-plants/flower-structure-and-pollination/index.html","type":"short","q":"Differentiate self-pollination and cross-pollination.","solution":"Self-pollination transfers pollen within the same flower or plant; cross-pollination transfers pollen between different plants."},{"i":3,"chapter":"Sexual Reproduction in Flowering Plants","topic":"Double Fertilisation and Seed Development","url":"chapter-01-sexual-reproduction-in-flowering-plants/double-fertilisation-and-seed-development/index.html","type":"mcq","q":"Endosperm in angiosperms is:","solution":"Double fertilisation produces triploid endosperm.","options":["Triploid","Diploid","Haploid","Tetraploid"],"answer":0},{"i":4,"chapter":"Sexual Reproduction in Flowering Plants","topic":"Double Fertilisation and Seed Development","url":"chapter-01-sexual-reproduction-in-flowering-plants/double-fertilisation-and-seed-development/index.html","type":"mcq","q":"A fruit develops from the:","solution":"The ovary wall becomes the fruit.","options":["Ovary","Ovule","Stigma","Anther"],"answer":0},{"i":5,"chapter":"Sexual Reproduction in Flowering Plants","topic":"Double Fertilisation and Seed Development","url":"chapter-01-sexual-reproduction-in-flowering-plants/double-fertilisation-and-seed-development/index.html","type":"short","q":"What is double fertilisation?","solution":"Two male gametes fuse: one with the egg (zygote) and one with polar nuclei (endosperm)."},{"i":6,"chapter":"Human Reproduction","topic":"Male and Female Reproductive Systems","url":"chapter-02-human-reproduction/male-and-female-reproductive-systems/index.html","type":"mcq","q":"Fertilisation in humans occurs in the:","solution":"Sperm meets the egg in the fallopian tube.","options":["Fallopian tube","Uterus","Ovary","Cervix"],"answer":0},{"i":7,"chapter":"Human Reproduction","topic":"Male and Female Reproductive Systems","url":"chapter-02-human-reproduction/male-and-female-reproductive-systems/index.html","type":"mcq","q":"Ovulation is triggered by a surge of:","solution":"The LH surge induces ovulation.","options":["LH","FSH","Progesterone","Prolactin"],"answer":0},{"i":8,"chapter":"Human Reproduction","topic":"Male and Female Reproductive Systems","url":"chapter-02-human-reproduction/male-and-female-reproductive-systems/index.html","type":"short","q":"What is the function of the corpus luteum?","solution":"It secretes progesterone, which maintains the uterine lining for implantation."},{"i":9,"chapter":"Human Reproduction","topic":"Embryonic Development and Parturition","url":"chapter-02-human-reproduction/embryonic-development-and-parturition/index.html","type":"mcq","q":"The zygote implants in the:","solution":"Implantation occurs in the uterine wall.","options":["Uterus","Fallopian tube","Ovary","Cervix"],"answer":0},{"i":10,"chapter":"Human Reproduction","topic":"Embryonic Development and Parturition","url":"chapter-02-human-reproduction/embryonic-development-and-parturition/index.html","type":"mcq","q":"Which hormone initiates labour contractions?","solution":"Oxytocin stimulates uterine muscle contraction.","options":["Oxytocin","Insulin","Thyroxine","Testosterone"],"answer":0},{"i":11,"chapter":"Human Reproduction","topic":"Embryonic Development and Parturition","url":"chapter-02-human-reproduction/embryonic-development-and-parturition/index.html","type":"short","q":"Why are identical twins genetically the same?","solution":"They develop from a single fertilised egg that splits into two embryos."},{"i":12,"chapter":"Reproductive Health","topic":"Reproductive Health and Family Planning","url":"chapter-03-reproductive-health/reproductive-health-and-family-planning/index.html","type":"mcq","q":"Which contraceptive method also prevents STIs?","solution":"Barrier methods block both sperm and pathogens.","options":["Condoms","Oral pills","IUDs","Sterilisation"],"answer":0},{"i":13,"chapter":"Reproductive Health","topic":"Reproductive Health and Family Planning","url":"chapter-03-reproductive-health/reproductive-health-and-family-planning/index.html","type":"mcq","q":"Reproductive health includes:","solution":"It is a broad state of well-being related to reproduction.","options":["Physical, mental and social well-being","Only physical health","Only fertility","Only contraception"],"answer":0},{"i":14,"chapter":"Reproductive Health","topic":"Reproductive Health and Family Planning","url":"chapter-03-reproductive-health/reproductive-health-and-family-planning/index.html","type":"short","q":"Why is counselling important for reproductive health?","solution":"It helps people make informed, safe choices and avoid misinformation and infection."},{"i":15,"chapter":"Reproductive Health","topic":"Infertility, ART and Prenatal Care","url":"chapter-03-reproductive-health/infertility-art-and-prenatal-care/index.html","type":"mcq","q":"IVF stands for:","solution":"Fertilisation occurs outside the body in a dish.","options":["In vitro fertilisation","In vivo fertilisation","Internal fertilisation","Incomplete fertilisation"],"answer":0},{"i":16,"chapter":"Reproductive Health","topic":"Infertility, ART and Prenatal Care","url":"chapter-03-reproductive-health/infertility-art-and-prenatal-care/index.html","type":"mcq","q":"Which is used to detect genetic disorders before birth?","solution":"Prenatal tests examine foetal cells or fluid.","options":["Prenatal diagnosis","Vaccination","Dialysis","Biopsy of the mother"],"answer":0},{"i":17,"chapter":"Reproductive Health","topic":"Infertility, ART and Prenatal Care","url":"chapter-03-reproductive-health/infertility-art-and-prenatal-care/index.html","type":"short","q":"What is surrogacy?","solution":"An arrangement in which a woman carries and delivers a child for another couple or person."},{"i":18,"chapter":"Principles of Inheritance and Variation","topic":"Mendelian Genetics and Deviations","url":"chapter-04-principles-of-inheritance-and-variation/mendelian-genetics-and-deviations/index.html","type":"mcq","q":"In incomplete dominance, the F1 phenotype is:","solution":"Neither allele masks the other fully.","options":["Intermediate","Dominant","Recessive","Absent"],"answer":0},{"i":19,"chapter":"Principles of Inheritance and Variation","topic":"Mendelian Genetics and Deviations","url":"chapter-04-principles-of-inheritance-and-variation/mendelian-genetics-and-deviations/index.html","type":"mcq","q":"AB blood group is an example of:","solution":"Both A and B antigens are expressed.","options":["Codominance","Incomplete dominance","Pleiotropy","Epistasis"],"answer":0},{"i":20,"chapter":"Principles of Inheritance and Variation","topic":"Mendelian Genetics and Deviations","url":"chapter-04-principles-of-inheritance-and-variation/mendelian-genetics-and-deviations/index.html","type":"short","q":"State Mendel's law of independent assortment.","solution":"Genes for different traits are inherited independently of each other during gamete formation."},{"i":21,"chapter":"Principles of Inheritance and Variation","topic":"Linkage, Sex Determination and Genetic Disorders","url":"chapter-04-principles-of-inheritance-and-variation/linkage-sex-determination-and-genetic-disorders/index.html","type":"mcq","q":"Colour blindness is:","solution":"The gene is on the X chromosome.","options":["X-linked recessive","Autosomal dominant","Y-linked only","Mitochondrial"],"answer":0},{"i":22,"chapter":"Principles of Inheritance and Variation","topic":"Linkage, Sex Determination and Genetic Disorders","url":"chapter-04-principles-of-inheritance-and-variation/linkage-sex-determination-and-genetic-disorders/index.html","type":"mcq","q":"Down syndrome is due to:","solution":"Three copies of chromosome 21 cause the condition.","options":["Trisomy of chromosome 21","Monosomy of 21","Sex chromosome loss","Mutation in one gene"],"answer":0},{"i":23,"chapter":"Principles of Inheritance and Variation","topic":"Linkage, Sex Determination and Genetic Disorders","url":"chapter-04-principles-of-inheritance-and-variation/linkage-sex-determination-and-genetic-disorders/index.html","type":"short","q":"Why are more males affected by X-linked recessive disorders?","solution":"Males have only one X chromosome, so a single recessive allele is expressed."},{"i":24,"chapter":"Molecular Basis of Inheritance","topic":"DNA Structure, Replication and Transcription","url":"chapter-05-molecular-basis-of-inheritance/dna-structure-replication-and-transcription/index.html","type":"mcq","q":"DNA replication is:","solution":"Each new DNA molecule keeps one parental strand.","options":["Semi-conservative","Conservative","Dispersive","Random"],"answer":0},{"i":25,"chapter":"Molecular Basis of Inheritance","topic":"DNA Structure, Replication and Transcription","url":"chapter-05-molecular-basis-of-inheritance/dna-structure-replication-and-transcription/index.html","type":"mcq","q":"A codon consists of:","solution":"Codons are triplets of bases.","options":["Three nucleotides","Two nucleotides","One nucleotide","Four nucleotides"],"answer":0},{"i":26,"chapter":"Molecular Basis of Inheritance","topic":"DNA Structure, Replication and Transcription","url":"chapter-05-molecular-basis-of-inheritance/dna-structure-replication-and-transcription/index.html","type":"short","q":"Why is DNA a better genetic material than RNA?","solution":"Its double-stranded structure allows accurate replication and repair, and its stability protects information."},{"i":27,"chapter":"Molecular Basis of Inheritance","topic":"Translation, Regulation and the Human Genome","url":"chapter-05-molecular-basis-of-inheritance/translation-regulation-and-the-human-genome/index.html","type":"mcq","q":"Translation occurs on the:","solution":"Ribosomes translate mRNA into protein.","options":["Ribosome","Nucleus","Lysosome","Golgi body"],"answer":0},{"i":28,"chapter":"Molecular Basis of Inheritance","topic":"Translation, Regulation and the Human Genome","url":"chapter-05-molecular-basis-of-inheritance/translation-regulation-and-the-human-genome/index.html","type":"mcq","q":"The lac operon is induced by:","solution":"Lactose inactivates the repressor.","options":["Lactose","Glucose","Galactose","Sucrose"],"answer":0},{"i":29,"chapter":"Molecular Basis of Inheritance","topic":"Translation, Regulation and the Human Genome","url":"chapter-05-molecular-basis-of-inheritance/translation-regulation-and-the-human-genome/index.html","type":"short","q":"What is a mutation?","solution":"A change in the DNA sequence that may alter the protein produced."},{"i":30,"chapter":"Evolution","topic":"Evidence and Mechanisms of Evolution","url":"chapter-06-evolution/evidence-and-mechanisms-of-evolution/index.html","type":"mcq","q":"Homologous organs indicate:","solution":"Similar structure in different species suggests shared origin.","options":["Common ancestry","Convergent evolution","No evolution","Random mutation"],"answer":0},{"i":31,"chapter":"Evolution","topic":"Evidence and Mechanisms of Evolution","url":"chapter-06-evolution/evidence-and-mechanisms-of-evolution/index.html","type":"mcq","q":"The main mechanism of adaptive evolution is:","solution":"Selection favours traits that improve survival and reproduction.","options":["Natural selection","Genetic drift","Mutation only","Migration only"],"answer":0},{"i":32,"chapter":"Evolution","topic":"Evidence and Mechanisms of Evolution","url":"chapter-06-evolution/evidence-and-mechanisms-of-evolution/index.html","type":"short","q":"How does antibiotic resistance illustrate natural selection?","solution":"Resistant bacteria survive treatment and reproduce, so the resistant trait increases in the population."},{"i":33,"chapter":"Evolution","topic":"Speciation and Human Evolution","url":"chapter-06-evolution/speciation-and-human-evolution/index.html","type":"mcq","q":"Reproductive isolation leads to:","solution":"Isolation stops gene flow and allows divergence.","options":["Speciation","Extinction","Hybrid vigour","Cloning"],"answer":0},{"i":34,"chapter":"Evolution","topic":"Speciation and Human Evolution","url":"chapter-06-evolution/speciation-and-human-evolution/index.html","type":"mcq","q":"Adaptive radiation produces:","solution":"Many species diverge to fill different niches.","options":["Many species from one ancestor","One species from many","Extinction","Cloning"],"answer":0},{"i":35,"chapter":"Evolution","topic":"Speciation and Human Evolution","url":"chapter-06-evolution/speciation-and-human-evolution/index.html","type":"short","q":"What is allopatric speciation?","solution":"Speciation caused by geographic separation of populations, leading to reproductive isolation."},{"i":36,"chapter":"Human Health and Disease","topic":"Pathogens, Immunity and Vaccines","url":"chapter-07-human-health-and-disease/pathogens-immunity-and-vaccines/index.html","type":"mcq","q":"Antibodies are produced by:","solution":"B lymphocytes produce antibodies.","options":["B cells","T cells","Red blood cells","Platelets"],"answer":0},{"i":37,"chapter":"Human Health and Disease","topic":"Pathogens, Immunity and Vaccines","url":"chapter-07-human-health-and-disease/pathogens-immunity-and-vaccines/index.html","type":"mcq","q":"Vaccination provides:","solution":"The immune system actively responds to the vaccine.","options":["Active acquired immunity","Passive immunity","Innate immunity only","No immunity"],"answer":0},{"i":38,"chapter":"Human Health and Disease","topic":"Pathogens, Immunity and Vaccines","url":"chapter-07-human-health-and-disease/pathogens-immunity-and-vaccines/index.html","type":"short","q":"Differentiate active and passive immunity.","solution":"Active immunity is produced by the body after exposure; passive immunity is received ready-made from another source."},{"i":39,"chapter":"Human Health and Disease","topic":"Major Diseases and Their Prevention","url":"chapter-07-human-health-and-disease/major-diseases-and-their-prevention/index.html","type":"mcq","q":"Malaria is transmitted by:","solution":"Anopheles mosquitoes transmit the malaria parasite.","options":["Female Anopheles mosquito","Housefly","Aedes aegypti","Tsetse fly"],"answer":0},{"i":40,"chapter":"Human Health and Disease","topic":"Major Diseases and Their Prevention","url":"chapter-07-human-health-and-disease/major-diseases-and-their-prevention/index.html","type":"mcq","q":"HIV primarily attacks:","solution":"Loss of helper T cells cripples immunity.","options":["Helper T cells","Red blood cells","Platelets","Neurons"],"answer":0},{"i":41,"chapter":"Human Health and Disease","topic":"Major Diseases and Their Prevention","url":"chapter-07-human-health-and-disease/major-diseases-and-their-prevention/index.html","type":"short","q":"Why is cancer called a disease of uncontrolled cell division?","solution":"Control mechanisms fail, so cells divide continuously and can spread to other tissues."},{"i":42,"chapter":"Microbes in Human Welfare","topic":"Microbes in Food, Industry and Medicine","url":"chapter-08-microbes-in-human-welfare/microbes-in-food-industry-and-medicine/index.html","type":"mcq","q":"Which microorganism is used in bread making?","solution":"Yeast ferments sugars and releases CO2, raising the dough.","options":["Yeast","Lactobacillus","Rhizobium","Amoeba"],"answer":0},{"i":43,"chapter":"Microbes in Human Welfare","topic":"Microbes in Food, Industry and Medicine","url":"chapter-08-microbes-in-human-welfare/microbes-in-food-industry-and-medicine/index.html","type":"mcq","q":"Biogas is produced by:","solution":"Methanogenic bacteria generate methane in anaerobic conditions.","options":["Methanogens","Nitrifying bacteria","Viruses","Algae only"],"answer":0},{"i":44,"chapter":"Microbes in Human Welfare","topic":"Microbes in Food, Industry and Medicine","url":"chapter-08-microbes-in-human-welfare/microbes-in-food-industry-and-medicine/index.html","type":"short","q":"Name two food products made using microorganisms.","solution":"Curd (Lactobacillus) and bread (yeast)."},{"i":45,"chapter":"Microbes in Human Welfare","topic":"Microbes in Agriculture, Waste Treatment and Biocontrol","url":"chapter-08-microbes-in-human-welfare/microbes-in-agriculture-waste-treatment-and-biocontrol/index.html","type":"mcq","q":"Rhizobium helps plants by:","solution":"It fixes atmospheric nitrogen in nodules.","options":["Fixing nitrogen","Killing insects","Producing oxygen only","Absorbing water only"],"answer":0},{"i":46,"chapter":"Microbes in Human Welfare","topic":"Microbes in Agriculture, Waste Treatment and Biocontrol","url":"chapter-08-microbes-in-human-welfare/microbes-in-agriculture-waste-treatment-and-biocontrol/index.html","type":"mcq","q":"Which is a biocontrol agent?","solution":"Trichoderma is a fungus used against plant pathogens.","options":["Trichoderma","Nitrogen gas","Plastic","Diesel"],"answer":0},{"i":47,"chapter":"Microbes in Human Welfare","topic":"Microbes in Agriculture, Waste Treatment and Biocontrol","url":"chapter-08-microbes-in-human-welfare/microbes-in-agriculture-waste-treatment-and-biocontrol/index.html","type":"short","q":"How does sewage treatment use microorganisms?","solution":"Aerobic and anaerobic bacteria decompose organic matter, reducing BOD and producing cleaner water."},{"i":48,"chapter":"Biotechnology: Principles and Processes","topic":"Recombinant DNA Technology","url":"chapter-09-biotechnology-principles-and-processes/recombinant-dna-technology/index.html","type":"mcq","q":"Restriction enzymes cut DNA at:","solution":"They recognise specific base sequences.","options":["Specific recognition sequences","Random points","Only ends","Only RNA"],"answer":0},{"i":49,"chapter":"Biotechnology: Principles and Processes","topic":"Recombinant DNA Technology","url":"chapter-09-biotechnology-principles-and-processes/recombinant-dna-technology/index.html","type":"mcq","q":"PCR is used to:","solution":"Polymerase chain reaction multiplies DNA copies.","options":["Amplify DNA","Cut DNA","Join DNA only","Extract proteins"],"answer":0},{"i":50,"chapter":"Biotechnology: Principles and Processes","topic":"Recombinant DNA Technology","url":"chapter-09-biotechnology-principles-and-processes/recombinant-dna-technology/index.html","type":"short","q":"What is a plasmid?","solution":"A small circular DNA molecule used as a vector to carry foreign genes into bacteria."},{"i":51,"chapter":"Biotechnology: Principles and Processes","topic":"Cloning, Bioreactors and Safety","url":"chapter-09-biotechnology-principles-and-processes/cloning-bioreactors-and-safety/index.html","type":"mcq","q":"A clone is:","solution":"Clones carry the same genetic material.","options":["Genetically identical to the parent","A hybrid","A mutant","A virus"],"answer":0},{"i":52,"chapter":"Biotechnology: Principles and Processes","topic":"Cloning, Bioreactors and Safety","url":"chapter-09-biotechnology-principles-and-processes/cloning-bioreactors-and-safety/index.html","type":"mcq","q":"Downstream processing refers to:","solution":"It covers separation and purification of the product.","options":["Purifying the product after reaction","Growing cells","Cutting DNA","Ethical review"],"answer":0},{"i":53,"chapter":"Biotechnology: Principles and Processes","topic":"Cloning, Bioreactors and Safety","url":"chapter-09-biotechnology-principles-and-processes/cloning-bioreactors-and-safety/index.html","type":"short","q":"Why are ethical guidelines important in biotechnology?","solution":"They protect safety, privacy and fairness while enabling beneficial applications."},{"i":54,"chapter":"Biotechnology and Its Applications","topic":"Agriculture and Medicine","url":"chapter-10-biotechnology-and-its-applications/agriculture-and-medicine/index.html","type":"mcq","q":"Bt crops are resistant to:","solution":"They carry a gene from Bacillus thuringiensis that kills specific insects.","options":["Insect pests","Herbicides only","Viruses only","Drought only"],"answer":0},{"i":55,"chapter":"Biotechnology and Its Applications","topic":"Agriculture and Medicine","url":"chapter-10-biotechnology-and-its-applications/agriculture-and-medicine/index.html","type":"mcq","q":"Golden rice is enriched in:","solution":"It was developed to combat vitamin A deficiency.","options":["Vitamin A","Vitamin C","Iron","Protein only"],"answer":0},{"i":56,"chapter":"Biotechnology and Its Applications","topic":"Agriculture and Medicine","url":"chapter-10-biotechnology-and-its-applications/agriculture-and-medicine/index.html","type":"short","q":"Give one medical application of biotechnology.","solution":"Production of human insulin by recombinant bacteria for treating diabetes."},{"i":57,"chapter":"Biotechnology and Its Applications","topic":"Transgenic Animals and Ethical Issues","url":"chapter-10-biotechnology-and-its-applications/transgenic-animals-and-ethical-issues/index.html","type":"mcq","q":"A transgenic animal:","solution":"A foreign gene has been inserted into its genome.","options":["Carries a foreign gene","Is always a clone","Cannot reproduce","Is a plant"],"answer":0},{"i":58,"chapter":"Biotechnology and Its Applications","topic":"Transgenic Animals and Ethical Issues","url":"chapter-10-biotechnology-and-its-applications/transgenic-animals-and-ethical-issues/index.html","type":"mcq","q":"Biosafety guidelines protect:","solution":"They reduce risks from GM organisms.","options":["Human health and the environment","Only industry profit","Only animals","Only plants"],"answer":0},{"i":59,"chapter":"Biotechnology and Its Applications","topic":"Transgenic Animals and Ethical Issues","url":"chapter-10-biotechnology-and-its-applications/transgenic-animals-and-ethical-issues/index.html","type":"short","q":"Why is animal welfare a concern in biotechnology?","solution":"Genetic modification and cloning can affect animal health and involve ethical trade-offs."},{"i":60,"chapter":"Organisms and Populations","topic":"Population Characteristics and Growth","url":"chapter-11-organisms-and-populations/population-characteristics-and-growth/index.html","type":"mcq","q":"Logistic growth accounts for:","solution":"Growth slows as N approaches K.","options":["Carrying capacity","Infinite resources","No competition","Constant death rate"],"answer":0},{"i":61,"chapter":"Organisms and Populations","topic":"Population Characteristics and Growth","url":"chapter-11-organisms-and-populations/population-characteristics-and-growth/index.html","type":"mcq","q":"Population density is:","solution":"Density is numbers per unit area or volume.","options":["Individuals per unit area","Total individuals only","Birth rate only","Death rate only"],"answer":0},{"i":62,"chapter":"Organisms and Populations","topic":"Population Characteristics and Growth","url":"chapter-11-organisms-and-populations/population-characteristics-and-growth/index.html","type":"short","q":"Differentiate exponential and logistic growth.","solution":"Exponential growth assumes unlimited resources; logistic growth includes a carrying capacity that slows growth."},{"i":63,"chapter":"Organisms and Populations","topic":"Species Interactions and Adaptations","url":"chapter-11-organisms-and-populations/species-interactions-and-adaptations/index.html","type":"mcq","q":"Mycorrhiza is an example of:","solution":"Both fungus and plant benefit.","options":["Mutualism","Parasitism","Competition","Predation"],"answer":0},{"i":64,"chapter":"Organisms and Populations","topic":"Species Interactions and Adaptations","url":"chapter-11-organisms-and-populations/species-interactions-and-adaptations/index.html","type":"mcq","q":"Predation typically:","solution":"Predators reduce prey numbers and shape adaptations.","options":["Controls prey population size","Increases prey unlimitedly","Has no effect","Only affects predators"],"answer":0},{"i":65,"chapter":"Organisms and Populations","topic":"Species Interactions and Adaptations","url":"chapter-11-organisms-and-populations/species-interactions-and-adaptations/index.html","type":"short","q":"Why are mutualistic relationships important in ecosystems?","solution":"They improve survival, nutrition and reproduction for both partners, supporting ecosystem stability."},{"i":66,"chapter":"Ecosystem","topic":"Energy Flow and Nutrient Cycling","url":"chapter-12-ecosystem/energy-flow-and-nutrient-cycling/index.html","type":"mcq","q":"Energy transfer between trophic levels is about:","solution":"The ten per cent law governs energy flow.","options":["10%","50%","90%","100%"],"answer":0},{"i":67,"chapter":"Ecosystem","topic":"Energy Flow and Nutrient Cycling","url":"chapter-12-ecosystem/energy-flow-and-nutrient-cycling/index.html","type":"mcq","q":"A pyramid of energy is always:","solution":"Energy always decreases upward.","options":["Upright","Inverted","Horizontal","Variable"],"answer":0},{"i":68,"chapter":"Ecosystem","topic":"Energy Flow and Nutrient Cycling","url":"chapter-12-ecosystem/energy-flow-and-nutrient-cycling/index.html","type":"short","q":"Why is the number of trophic levels limited?","solution":"So little energy remains after several transfers that further levels cannot be supported."},{"i":69,"chapter":"Ecosystem","topic":"Ecological Succession and Ecosystem Services","url":"chapter-12-ecosystem/ecological-succession-and-ecosystem-services/index.html","type":"mcq","q":"Pioneer species in primary succession on rock are:","solution":"Lichens can colonise bare rock.","options":["Lichens","Trees","Grasses","Ferns"],"answer":0},{"i":70,"chapter":"Ecosystem","topic":"Ecological Succession and Ecosystem Services","url":"chapter-12-ecosystem/ecological-succession-and-ecosystem-services/index.html","type":"mcq","q":"Ecosystem services include:","solution":"These are benefits ecosystems provide to humans.","options":["Pollination and water purification","Only food","Only timber","Only minerals"],"answer":0},{"i":71,"chapter":"Ecosystem","topic":"Ecological Succession and Ecosystem Services","url":"chapter-12-ecosystem/ecological-succession-and-ecosystem-services/index.html","type":"short","q":"What is ecological succession?","solution":"The gradual, predictable change in community composition over time toward a stable climax."},{"i":72,"chapter":"Biodiversity and Conservation","topic":"Levels and Patterns of Biodiversity","url":"chapter-13-biodiversity-and-conservation/levels-and-patterns-of-biodiversity/index.html","type":"mcq","q":"Which region has the greatest species diversity?","solution":"Tropical regions hold the highest species richness.","options":["Tropics","Poles","Deserts","Deep ocean only"],"answer":0},{"i":73,"chapter":"Biodiversity and Conservation","topic":"Levels and Patterns of Biodiversity","url":"chapter-13-biodiversity-and-conservation/levels-and-patterns-of-biodiversity/index.html","type":"mcq","q":"A biodiversity hotspot has:","solution":"Hotspots combine richness with vulnerability.","options":["High endemism and high threat","Low endemism","Only deserts","No threat"],"answer":0},{"i":74,"chapter":"Biodiversity and Conservation","topic":"Levels and Patterns of Biodiversity","url":"chapter-13-biodiversity-and-conservation/levels-and-patterns-of-biodiversity/index.html","type":"short","q":"Name three causes of biodiversity loss.","solution":"Habitat destruction, overexploitation and invasive species (also pollution and climate change)."},{"i":75,"chapter":"Biodiversity and Conservation","topic":"Conservation Strategies","url":"chapter-13-biodiversity-and-conservation/conservation-strategies/index.html","type":"mcq","q":"A national park is an example of:","solution":"Protected areas conserve species in their natural habitat.","options":["In situ conservation","Ex situ conservation","A zoo","A seed bank"],"answer":0},{"i":76,"chapter":"Biodiversity and Conservation","topic":"Conservation Strategies","url":"chapter-13-biodiversity-and-conservation/conservation-strategies/index.html","type":"mcq","q":"A seed bank is an example of:","solution":"Seeds are stored outside the natural habitat.","options":["Ex situ conservation","In situ conservation","Pollution control","Habitat destruction"],"answer":0},{"i":77,"chapter":"Biodiversity and Conservation","topic":"Conservation Strategies","url":"chapter-13-biodiversity-and-conservation/conservation-strategies/index.html","type":"short","q":"Why is community participation important for conservation?","solution":"Local people depend on and manage ecosystems, so their involvement makes protection practical and lasting."}]